# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o GitHub. Peça os valores ao responsável pelo projeto.

# Endereço do TestLab (playground publicado ou http://localhost:3001 para rodar local)
BASE_URL=
# Chave de acesso do playground (header X-Playground-Key)
PLAYGROUND_KEY=
# Senha das contas de exemplo do TestLab
TEST_PASSWORD=
